        "\n",
        "# CANDIDATE-ELIMINATION ALGORITHM\n",
        "# Google Colab: CSV + Output + Bar Graph\n",
        "\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from itertools import product\n",
        "\n",
        "# 1. Create training data and save as CSV\n",
        "data = {\n",
        "    'Sky': ['Sunny', 'Sunny', 'Rainy', 'Sunny'],\n",
        "    'Temperature': ['Warm', 'Warm', 'Cold', 'Warm'],\n",
        "    'Humidity': ['Normal', 'High', 'High', 'High'],\n",
        "    'Wind': ['Strong', 'Strong', 'Strong', 'Weak'],\n",
        "    'EnjoySport': ['Yes', 'Yes', 'No', 'Yes']\n",
        "}\n",
        "\n",
        "pd.DataFrame(data).to_csv('training_data.csv', index=False)\n",
        "\n",
        "# 2. Read data from CSV file\n",
        "df = pd.read_csv('training_data.csv')\n",
        "\n",
        "print(\"TRAINING DATA:\")\n",
        "print(df.to_string(index=False))\n",
        "\n",
        "attributes = list(df.columns[:-1])\n",
        "examples = df.iloc[:, :-1].values.tolist()\n",
        "labels = df.iloc[:, -1].tolist()\n",
        "domains = [df[a].unique().tolist() for a in attributes]\n",
        "n = len(attributes)\n",
        "\n",
        "# 3. Functions used by the algorithm\n",
        "\n",
        "def covers(h, x):\n",
        "    return all(h[j] == '?' or h[j] == x[j] for j in range(n))\n",
        "\n",
        "def more_general(h1, h2):\n",
        "    return all(a == '?' or a == b for a, b in zip(h1, h2))\n",
        "\n",
        "def remove_redundant(hypotheses):\n",
        "    result = []\n",
        "    for h in hypotheses:\n",
        "        if h not in result:\n",
        "            result.append(h)\n",
        "    return [\n",
        "        h for h in result\n",
        "        if not any(\n",
        "            h != other and more_general(h, other)\n",
        "            for other in result\n",
        "        )\n",
        "    ]\n",
        "\n",
        "def generalize(s, x):\n",
        "    return [\n",
        "        x[j] if s[j] == 'Ø' else\n",
        "        s[j] if s[j] == x[j] else '?'\n",
        "        for j in range(n)\n",
        "    ]\n",
        "\n",
        "def specialize(g, x, S):\n",
        "    candidates = []\n",
        "    for j in range(n):\n",
        "        if g[j] == '?':\n",
        "            for value in domains[j]:\n",
        "                if value != x[j]:\n",
        "                    h = g.copy()\n",
        "                    h[j] = value\n",
        "                    if any(more_general(h, s) for s in S):\n",
        "                        candidates.append(h)\n",
        "    return candidates\n",
        "\n",
        "# 4. Initialize boundaries\n",
        "S = [['Ø'] * n]\n",
        "G = [['?'] * n]\n",
        "\n",
        "# 5. Candidate-Elimination algorithm\n",
        "for x, label in zip(examples, labels):\n",
        "\n",
        "    if label == 'Yes':\n",
        "        # Remove hypotheses in G that reject a positive example\n",
        "        G = [g for g in G if covers(g, x)]\n",
        "\n",
        "        # Generalize S to cover the positive example\n",
        "        new_S = []\n",
        "        for s in S:\n",
        "            if covers(s, x):\n",
        "                new_S.append(s)\n",
        "            else:\n",
        "                new_S.append(generalize(s, x))\n",
        "\n",
        "        S = remove_redundant(new_S)\n",
        "\n",
        "    else:\n",
        "        # Remove hypotheses in S that cover a negative example\n",
        "        S = [s for s in S if not covers(s, x)]\n",
        "\n",
        "        # Specialize hypotheses in G that cover a negative example\n",
        "        new_G = []\n",
        "        for g in G:\n",
        "            if covers(g, x):\n",
        "                new_G.extend(specialize(g, x, S))\n",
        "            else:\n",
        "                new_G.append(g)\n",
        "\n",
        "        G = remove_redundant(new_G)\n",
        "\n",
        "    print(\"\\nExample:\", x, \"Class:\", label)\n",
        "    print(\"S Boundary:\", S)\n",
        "    print(\"G Boundary:\", G)\n",
        "\n",
        "# 6. Display final boundaries\n",
        "print(\"\\nFINAL SPECIFIC BOUNDARY (S):\")\n",
        "for h in S:\n",
        "    print(h)\n",
        "\n",
        "print(\"\\nFINAL GENERAL BOUNDARY (G):\")\n",
        "for h in G:\n",
        "    print(h)\n",
        "\n",
        "print(\"\\nHYPOTHESES CONSISTENT WITH THE TRAINING DATA\")\n",
        "print(\"The consistent hypothesis space is represented\")\n",
        "print(\"by the hypotheses between the S and G boundaries.\")\n",
        "\n",
        "# 7. Bar graph\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "boundary_names = ['Specific Boundary (S)', 'General Boundary (G)']\n",
        "boundary_counts = [len(S), len(G)]\n",
        "\n",
        "bars = plt.bar(boundary_names, boundary_counts)\n",
        "\n",
        "plt.title('Candidate-Elimination Algorithm')\n",
        "plt.ylabel('Number of Boundary Hypotheses')\n",
        "plt.xlabel('Hypothesis Boundaries')\n",
        "plt.bar_label(bars)\n",
        "plt.grid(axis='y', linestyle='--', alpha=0.4)\n",
        "plt.tight_layout()\n",
        "plt.show()"
