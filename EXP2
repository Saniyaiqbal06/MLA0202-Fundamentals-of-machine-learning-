        "# ==========================================\n",
        "# FIND-S ALGORITHM WITH GRAPH\n",
        "# Google Colab Compatible\n",
        "# ==========================================\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# -----------------------------\n",
        "# 1. Training Data\n",
        "# -----------------------------\n",
        "\n",
        "data = [\n",
        "    ['Sunny', 'Warm', 'Normal', 'Strong', 'Yes'],\n",
        "    ['Sunny', 'Warm', 'High',   'Strong', 'Yes'],\n",
        "    ['Rainy', 'Cold', 'High',   'Strong', 'No'],\n",
        "    ['Sunny', 'Warm', 'High',   'Weak',   'Yes']\n",
        "]\n",
        "\n",
        "attributes = ['Sky', 'Temperature', 'Humidity', 'Wind']\n",
        "\n",
        "# -----------------------------\n",
        "# 2. Find First Positive Example\n",
        "# -----------------------------\n",
        "\n",
        "hypothesis = None\n",
        "\n",
        "for row in data:\n",
        "    if row[-1] == 'Yes':\n",
        "        hypothesis = row[:-1].copy()\n",
        "        break\n",
        "\n",
        "print(\"FIND-S ALGORITHM\")\n",
        "print(\"-----------------\")\n",
        "\n",
        "print(\"Initial Hypothesis:\", hypothesis)\n",
        "\n",
        "# Store hypothesis after each example\n",
        "history = []\n",
        "\n",
        "# -----------------------------\n",
        "# 3. FIND-S Algorithm\n",
        "# -----------------------------\n",
        "\n",
        "for i, row in enumerate(data):\n",
        "\n",
        "    # Check only positive examples\n",
        "    if row[-1] == 'Yes':\n",
        "\n",
        "        for j in range(len(attributes)):\n",
        "\n",
        "            # If values are different, generalize\n",
        "            if hypothesis[j] != row[j]:\n",
        "                hypothesis[j] = '?'\n",
        "\n",
        "    history.append(hypothesis.copy())\n",
        "\n",
        "    print(\"After Example\", i + 1, \":\", hypothesis)\n",
        "\n",
        "# -----------------------------\n",
        "# 4. Final Hypothesis\n",
        "# -----------------------------\n",
        "\n",
        "print(\"\\nFinal Most Specific Hypothesis:\")\n",
        "print(hypothesis)\n",
        "\n",
        "# -----------------------------\n",
        "# 5. Convert Hypothesis to Numbers\n",
        "# -----------------------------\n",
        "# 1 = Specific value\n",
        "# 0 = Generalized '?'\n",
        "\n",
        "graph_data = []\n",
        "\n",
        "for h in history:\n",
        "\n",
        "    values = []\n",
        "\n",
        "    for value in h:\n",
        "\n",
        "        if value == '?':\n",
        "            values.append(0)\n",
        "        else:\n",
        "            values.append(1)\n",
        "\n",
        "    graph_data.append(values)\n",
        "\n",
        "# -----------------------------\n",
        "# 6. Create Graph\n",
        "# -----------------------------\n",
        "\n",
        "plt.figure(figsize=(12, 7))\n",
        "\n",
        "x = range(1, len(data) + 1)\n",
        "\n",
        "for j in range(len(attributes)):\n",
        "\n",
        "    y = [graph_data[i][j] for i in range(len(data))]\n",
        "\n",
        "    plt.plot(\n",
        "        x,\n",
        "        y,\n",
        "        marker='o',\n",
        "        linewidth=3,\n",
        "        markersize=8,\n",
        "        label=attributes[j]\n",
        "    )\n",
        "\n",
        "# -----------------------------\n",
        "# 7. Graph Labels\n",
        "# -----------------------------\n",
        "\n",
        "plt.title(\n",
        "    \"FIND-S Algorithm - Hypothesis Generalization\",\n",
        "    fontsize=16,\n",
        "    fontweight='bold'\n",
        ")\n",
        "\n",
        "plt.xlabel(\n",
        "    \"Training Example\",\n",
        "    fontsize=12\n",
        ")\n",
        "\n",
        "plt.ylabel(\n",
        "    \"Hypothesis Status\",\n",
        "    fontsize=12\n",
        ")\n",
        "\n",
        "plt.xticks(\n",
        "    range(1, len(data) + 1),\n",
        "    ['Example 1', 'Example 2', 'Example 3', 'Example 4']\n",
        ")\n",
        "\n",
        "plt.yticks(\n",
        "    [0, 1],\n",
        "    ['Generalized (?)', 'Specific Value']\n",
        ")\n",
        "\n",
        "plt.grid(True, linestyle='--', alpha=0.5)\n",
        "\n",
        "plt.legend(\n",
        "    title=\"Attributes\",\n",
        "    loc='best'\n",
        ")\n",
        "\n",
        "# -----------------------------\n",
        "# 8. Show Graph\n",
        "# -----------------------------\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
