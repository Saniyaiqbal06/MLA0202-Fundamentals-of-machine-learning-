        "\n",
        "# ARTIFICIAL NEURAL NETWORK USING BACKPROPAGATION\n",
        "# Google Colab compatible\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# 1. Training dataset (XOR problem)\n",
        "X = np.array([\n",
        "    [0, 0],\n",
        "    [0, 1],\n",
        "    [1, 0],\n",
        "    [1, 1]\n",
        "])\n",
        "\n",
        "Y = np.array([\n",
        "    [0],\n",
        "    [1],\n",
        "    [1],\n",
        "    [0]\n",
        "])\n",
        "\n",
        "# 2. Initialize weights and biases\n",
        "np.random.seed(42)\n",
        "\n",
        "input_neurons = 2\n",
        "hidden_neurons = 4\n",
        "output_neurons = 1\n",
        "\n",
        "W1 = np.random.randn(input_neurons, hidden_neurons)\n",
        "b1 = np.zeros((1, hidden_neurons))\n",
        "\n",
        "W2 = np.random.randn(hidden_neurons, output_neurons)\n",
        "b2 = np.zeros((1, output_neurons))\n",
        "\n",
        "learning_rate = 0.1\n",
        "epochs = 10000\n",
        "\n",
        "errors = []\n",
        "\n",
        "# Sigmoid activation function\n",
        "def sigmoid(x):\n",
        "    return 1 / (1 + np.exp(-x))\n",
        "\n",
        "# 3. Train the ANN using backpropagation\n",
        "for epoch in range(epochs):\n",
        "\n",
        "    # Forward propagation\n",
        "    hidden_input = np.dot(X, W1) + b1\n",
        "    hidden_output = sigmoid(hidden_input)\n",
        "\n",
        "    final_input = np.dot(hidden_output, W2) + b2\n",
        "    predicted_output = sigmoid(final_input)\n",
        "\n",
        "    # Calculate error\n",
        "    error = Y - predicted_output\n",
        "    loss = np.mean(error ** 2)\n",
        "    errors.append(loss)\n",
        "\n",
        "    # Backward propagation\n",
        "    output_delta = error * predicted_output * (1 - predicted_output)\n",
        "\n",
        "    hidden_error = np.dot(output_delta, W2.T)\n",
        "    hidden_delta = hidden_error * hidden_output * (1 - hidden_output)\n",
        "\n",
        "    # Update weights and biases\n",
        "    W2 += learning_rate * np.dot(hidden_output.T, output_delta)\n",
        "    b2 += learning_rate * np.sum(output_delta, axis=0, keepdims=True)\n",
        "\n",
        "    W1 += learning_rate * np.dot(X.T, hidden_delta)\n",
        "    b1 += learning_rate * np.sum(hidden_delta, axis=0, keepdims=True)\n",
        "\n",
        "# 4. Test the trained network\n",
        "hidden_output = sigmoid(np.dot(X, W1) + b1)\n",
        "predicted_output = sigmoid(np.dot(hidden_output, W2) + b2)\n",
        "\n",
        "print(\"ANN OUTPUT AFTER TRAINING\")\n",
        "print(\"-------------------------\")\n",
        "\n",
        "for i in range(len(X)):\n",
        "    predicted_class = 1 if predicted_output[i, 0] >= 0.5 else 0\n",
        "\n",
        "    print(\n",
        "        \"Input:\", X[i],\n",
        "        \"Expected:\", Y[i, 0],\n",
        "        \"Predicted:\", predicted_class,\n",
        "        \"Probability:\", round(predicted_output[i, 0], 3)\n",
        "    )\n",
        "\n",
        "# 5. Plot the training error graph\n",
        "plt.figure(figsize=(8, 5))\n",
        "plt.plot(errors)\n",
        "plt.title(\"ANN Backpropagation - Error During Training\")\n",
        "plt.xlabel(\"Epoch\")\n",
        "plt.ylabel(\"Mean Squared Error\")\n",
        "plt.grid(True)\n",
        "plt.show()"
      ]
