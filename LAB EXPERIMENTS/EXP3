        "\n",
        "# ID3 DECISION TREE ALGORITHM\n",
        "# Google Colab compatible\n",
        "\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.tree import DecisionTreeClassifier, plot_tree\n",
        "from sklearn.preprocessing import LabelEncoder\n",
        "\n",
        "# 1. Create the dataset\n",
        "data = {\n",
        "    'Outlook': ['Sunny', 'Sunny', 'Overcast', 'Rain', 'Rain',\n",
        "                'Rain', 'Overcast', 'Sunny', 'Sunny', 'Rain',\n",
        "                'Sunny', 'Overcast', 'Overcast', 'Rain'],\n",
        "    'Temperature': ['Hot', 'Hot', 'Hot', 'Mild', 'Cool',\n",
        "                    'Cool', 'Cool', 'Mild', 'Cool', 'Mild',\n",
        "                    'Mild', 'Mild', 'Hot', 'Mild'],\n",
        "    'Humidity': ['High', 'High', 'High', 'High', 'Normal',\n",
        "                 'Normal', 'Normal', 'High', 'Normal', 'Normal',\n",
        "                 'Normal', 'High', 'Normal', 'High'],\n",
        "    'Wind': ['Weak', 'Strong', 'Weak', 'Weak', 'Weak',\n",
        "             'Strong', 'Strong', 'Weak', 'Weak', 'Weak',\n",
        "             'Strong', 'Strong', 'Weak', 'Strong'],\n",
        "    'Play': ['No', 'No', 'Yes', 'Yes', 'Yes',\n",
        "             'No', 'Yes', 'No', 'Yes', 'Yes',\n",
        "             'Yes', 'Yes', 'Yes', 'No']\n",
        "}\n",
        "\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "print(\"TRAINING DATASET:\")\n",
        "print(df.to_string(index=False))\n",
        "\n",
        "# 2. Encode categorical data into numbers\n",
        "encoders = {}\n",
        "encoded_df = pd.DataFrame()\n",
        "\n",
        "for col in df.columns:\n",
        "    encoders[col] = LabelEncoder()\n",
        "    encoded_df[col] = encoders[col].fit_transform(df[col])\n",
        "\n",
        "X = encoded_df.drop('Play', axis=1)\n",
        "y = encoded_df['Play']\n",
        "\n",
        "# 3. Build the ID3 decision tree\n",
        "# entropy criterion is used for ID3\n",
        "model = DecisionTreeClassifier(\n",
        "    criterion='entropy',\n",
        "    random_state=0\n",
        ")\n",
        "\n",
        "model.fit(X, y)\n",
        "\n",
        "print(\"\\nDecision tree trained successfully!\")\n",
        "\n",
        "# 4. Display the decision tree graph\n",
        "plt.figure(figsize=(16, 8))\n",
        "\n",
        "plot_tree(\n",
        "    model,\n",
        "    feature_names=X.columns,\n",
        "    class_names=encoders['Play'].classes_,\n",
        "    filled=True,\n",
        "    rounded=True,\n",
        "    fontsize=10\n",
        ")\n",
        "\n",
        "plt.title(\"ID3 Decision Tree - Play Prediction\")\n",
        "plt.show()\n",
        "\n",
        "# 5. Classify a new sample\n",
        "new_sample = pd.DataFrame([{\n",
        "    'Outlook': 'Sunny',\n",
        "    'Temperature': 'Cool',\n",
        "    'Humidity': 'Normal',\n",
        "    'Wind': 'Weak'\n",
        "}])\n",
        "\n",
        "# Encode the new sample using training encoders\n",
        "new_encoded = pd.DataFrame()\n",
        "\n",
        "for col in X.columns:\n",
        "    new_encoded[col] = encoders[col].transform(new_sample[col])\n",
        "\n",
        "prediction = model.predict(new_encoded)[0]\n",
        "result = encoders['Play'].inverse_transform([prediction])[0]\n",
        "\n",
        "print(\"\\nNEW SAMPLE:\")\n",
        "print(new_sample.to_string(index=False))\n",
        "\n",
        "print(\"\\nPREDICTED CLASS:\", result)"
      ]
